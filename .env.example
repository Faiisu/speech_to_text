# Shared model and host identity settings (use ./legacies-poc/models if weights live in the legacy folder)
SPEECH_TO_TEXT_MODELS_DIR=./models
HOST_UID=1001
HOST_GID=1001
RENDER_GID=992
AUDIO_GID=29
# Compose profile: 'linux' (Production Intel GPU/ALSA) or 'mac' (macOS dev/test with host mic bridge)
COMPOSE_PROFILES=linux

# Linux service container
SPEECH_TO_TEXT_IMAGE=speech-to-text:local
CONTROL_CENTER_PORT=8765
SPEECH_TO_TEXT_HOST_PORT=18765

# Apple Silicon Docker Desktop test profile
SPEECH_TO_TEXT_MAC_TEST_IMAGE=speech-to-text:mac-test
MAC_TEST_PLATFORM=linux/arm64
MAC_TEST_CONTROL_CENTER_PORT=18766
MAC_TEST_MICROPHONE_BRIDGE_PORT=18767
