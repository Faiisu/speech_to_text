# Copy to .env and replace every placeholder before running Compose.
TELEMETRY_ADMIN_USER=telemetry_admin
TELEMETRY_ADMIN_PASSWORD=replace-with-a-long-local-admin-secret
TELEMETRY_WRITER_PASSWORD=replace-with-a-long-writer-secret
TELEMETRY_GRAFANA_PASSWORD=replace-with-a-long-readonly-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-grafana-admin-secret
TELEMETRY_DATABASE=speech_telemetry
TELEMETRY_DATABASE_PORT=5433
GRAFANA_PORT=3000

# Set this in the environment that launches the Speech-to-Text host service.
SPEECH_TO_TEXT_TELEMETRY_DATABASE_URL=postgresql://telemetry_writer:replace-writer-secret@127.0.0.1:5433/speech_telemetry
SPEECH_TO_TEXT_TELEMETRY_RETENTION_DAYS=30
SPEECH_TO_TEXT_MODEL_VOLUME_PATH=./models
# Use the admin credential only for schema changes or retention updates.
SPEECH_TO_TEXT_TELEMETRY_MIGRATION_DATABASE_URL=postgresql://telemetry_admin:replace-admin-secret@127.0.0.1:5433/speech_telemetry
